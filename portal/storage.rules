rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function admin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // PDFs e imagens do material de apoio. Leitura pública; envio só do admin.
    match /materiais/{materia}/{arquivo} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
      allow delete: if admin();
    }

    // Imagens usadas dentro dos conteúdos (evita base64 gigante no HTML).
    match /conteudos/{slug}/{arquivo} {
      allow read: if true;
      allow create, update: if admin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if admin();
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
